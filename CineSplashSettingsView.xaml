<UserControl x:Class="CineSplash.CineSplashSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CineSplash"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=WindowsBase"
             xmlns:events="clr-namespace:Playnite.SDK.Events;assembly=Playnite.SDK">
    <UserControl.Resources>
        <!-- Supplies the four enum values as an ItemsSource -->
        <ObjectDataProvider x:Key="VideoSourceValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:VideoSourcePreference"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Human-readable labels for each enum value -->
        <local:VideoSourceDescriptionConverter x:Key="VideoSourceConverter"/>

        <ObjectDataProvider x:Key="KeyValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="input:Key"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        
        <ObjectDataProvider x:Key="ControllerValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="events:ControllerInput"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- Top Level: Mode Selection -->
            <TextBlock Text="Splash Screen Close Mode" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>
            <CheckBox Content="Use Smart Window Detection (Recommended)"
                      IsChecked="{Binding EnableWindowDetection, UpdateSourceTrigger=PropertyChanged}"
                      FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Automatically detects when the game window appears and closes the splash screen at the exact right moment."
                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="20,0,0,15" TextWrapping="Wrap"/>
            <Separator Margin="0,10,0,20" Background="Gray" Opacity="0.3"/>

            <!-- Section A: Window Detection Settings -->
            <TextBlock Text="Window Detection Settings" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>
            <StackPanel Margin="10,0,0,20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EnableWindowDetection}" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Minimum Splash Duration:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MinimumSplashDuration, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="10,0,5,0"/>
                    <TextBlock Text="seconds" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Max Splash Duration (safety net):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MaxSplashDuration, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="10,0,5,0"/>
                    <TextBlock Text="seconds" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox Content="Show elapsed time on splash screen"
                          IsChecked="{Binding ShowElapsedTime, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Manual Selection Hotkey:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="RecordCalibrationHotkeyBtn" Content="Record Hotkey" Width="100" Click="RecordCalibrationHotkeyBtn_Click"/>
                    <TextBlock Text="Current:" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CalibrationHotkeyText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <TextBlock Text="Detected Games" FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
                
                <DataGrid ItemsSource="{Binding CalibrationEntries}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="False" SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Margin="0,0,0,5">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3A3A3A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Game" Binding="{Binding GameName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Window Title" Binding="{Binding WindowTitle}" Width="*"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding ElapsedSeconds}" Width="55" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Re-detect" Click="Recalibrate_Click" Tag="{Binding GameId}" Padding="4,2" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Clear" Click="ClearCalibration_Click" Tag="{Binding GameId}" Padding="4,2" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap">
                    <Run FontWeight="Bold">Re-detect:</Run>
                    <Run> Triggers Manual Window Selection on next launch (80% overlay with window picker).</Run>
                    <LineBreak/>
                    <Run FontWeight="Bold">Clear:</Run>
                    <Run> Removes detection data. Next launch will auto-detect the game window silently.</Run>
                </TextBlock>
            </StackPanel>

            <Separator Margin="0,0,0,20" Background="Gray" Opacity="0.3"/>

            <!-- Section B: Fixed Timer Settings -->
            <TextBlock Text="Fixed Timer Settings" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>
            <StackPanel Margin="10,0,0,20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EnableWindowDetection}" Value="True">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            <TextBlock Text="Default Splash Screen Duration (seconds):" Margin="0,0,0,5" FontWeight="Bold"/>
            <TextBox Text="{Binding SplashScreenDuration, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" HorizontalAlignment="Left" Margin="0,0,0,15"/>
            <CheckBox Content="Wait for game to start before timing splash screen duration"
                      IsChecked="{Binding UseGameStartedTimer, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,10"/>
            <!-- Platform-specific timers -->
            <CheckBox Content="Use platform-specific timers"
                      IsChecked="{Binding UsePlatformSpecificTimers, UpdateSourceTrigger=PropertyChanged}"
                      FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Configure different splash screen durations for each platform:"
                       Margin="0,0,0,10" FontStyle="Italic" Foreground="Gray"/>

            <Border BorderBrush="LightGray" BorderThickness="1" Padding="15" Margin="0,0,0,15"
                    IsEnabled="{Binding UsePlatformSpecificTimers}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UsePlatformSpecificTimers}" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Duration (sec)" FontWeight="Bold"/>

                    <ComboBox Grid.Row="1"  Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform1,  UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="1"  Grid.Column="1" Text="{Binding Duration1,  UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                    <ComboBox Grid.Row="2"  Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform2,  UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="2"  Grid.Column="1" Text="{Binding Duration2,  UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                    <ComboBox Grid.Row="3"  Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform3,  UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="3"  Grid.Column="1" Text="{Binding Duration3,  UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                    <ComboBox Grid.Row="4"  Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform4,  UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="4"  Grid.Column="1" Text="{Binding Duration4,  UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                    <ComboBox Grid.Row="5"  Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform5,  UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="5"  Grid.Column="1" Text="{Binding Duration5,  UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                    <ComboBox Grid.Row="6"  Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform6,  UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="6"  Grid.Column="1" Text="{Binding Duration6,  UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                    <ComboBox Grid.Row="7"  Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform7,  UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="7"  Grid.Column="1" Text="{Binding Duration7,  UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                    <ComboBox Grid.Row="8"  Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform8,  UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="8"  Grid.Column="1" Text="{Binding Duration8,  UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                    <ComboBox Grid.Row="9"  Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform9,  UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="9"  Grid.Column="1" Text="{Binding Duration9,  UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                    <ComboBox Grid.Row="10" Grid.Column="0" ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding Platform10, UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
                    <TextBox  Grid.Row="10" Grid.Column="1" Text="{Binding Duration10, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="5,0"/>
                </Grid>
            </Border>

            <TextBlock Text="Note: When platform-specific timers are disabled, the default duration will be used for all platforms."
                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,15"/>
            <!-- Game-specific durations -->
            <TextBlock Text="Game-Specific Durations (highest priority):" Margin="0,10,0,5" FontWeight="Bold"/>
            <TextBlock Text="Format: DatabaseID:Duration (one per line, e.g., f2885ae8-b448-4f87-bbaa-eb827423b4e3:15)"
                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
            <TextBox x:Name="GameSpecificTextBox"
                     Text="{Binding GameSpecificDurationsText, UpdateSourceTrigger=LostFocus}"
                     Height="100" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                     Padding="5" FontFamily="Consolas" Margin="0,0,0,10"/>
            <TextBlock Text="Note: Priority: 1) Game-specific durations (above), 2) Platform-specific durations, 3) Default duration"
                       FontStyle="Italic" Foreground="Purple" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
            </StackPanel>

            <Separator Margin="0,0,0,20" Background="Gray" Opacity="0.3"/>

            <!-- Global Settings -->
            <TextBlock Text="Global Settings" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>
            <StackPanel Margin="10,0,0,0">
            <TextBlock Text="Splash Screen Logo Size (px):" Margin="0,0,0,5" FontWeight="Bold"/>
            <TextBox Text="{Binding LogoSize, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" HorizontalAlignment="Left" Margin="0,0,0,5"/>
            <TextBlock Text="Note: The logo will be scaled to match the aspect ratio. Default is 300px."
                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,15"/>
            <!-- Show splash on game close -->
            <CheckBox Content="Show splash screen after closing a game (welcome back to Playnite)"
                      IsChecked="{Binding ShowSplashOnGameClose, UpdateSourceTrigger=PropertyChanged}"
                      FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="Triggers the splash screen when you return from a game."
                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="20,0,0,15"/>
            <!-- Skip Hotkey -->
            <TextBlock Text="Skip Splash Screen (Keyboard):" Margin="0,0,0,5" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="RecordHotkeyBtn" Content="Record Hotkey" Width="100" Click="RecordHotkeyBtn_Click"/>
                <TextBlock Text="Current Hotkey: " VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="Bold"/>
                <TextBlock Text="{Binding SkipHotkeyText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="(Press any keyboard combo to record)" FontStyle="Italic" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Skip Splash Screen (Controller):" Margin="0,0,0,5" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <ComboBox SelectedValue="{Binding SkipControllerButton, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Source={StaticResource ControllerValues}}"
                          Width="120" HorizontalAlignment="Left" />
                <TextBlock Text="+" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="Bold"/>
                <ComboBox SelectedValue="{Binding SkipControllerButton2, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Source={StaticResource ControllerValues}}"
                          Width="120" HorizontalAlignment="Left" />
                <TextBlock Text="Select a controller button or combo" FontStyle="Italic" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Note: Playnite must have 'Enable Controller Input' enabled in Desktop mode settings for this to work." FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,15"/>

            <!-- Mode visibility -->
            <TextBlock Text="Mode Visibility" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
            <TextBlock Text="Choose which Playnite modes should suppress the splash screen entirely."
                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>
            <CheckBox Content="Disable splash screen in Fullscreen mode"
                      IsChecked="{Binding DisableInFullscreen, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,6"/>
            <CheckBox Content="Disable splash screen in Desktop mode"
                      IsChecked="{Binding DisableInDesktop, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,5"/>
            <TextBlock Text="Tip: You can disable in both modes to effectively turn the addon off without uninstalling it."
                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,15"/>
            <!-- VIDEO SPLASH -->
            <TextBlock Text="Video Splash (Extra Metadata Loader)" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

            <CheckBox Content="Play video trailer as splash background (requires Extra Metadata Loader)"
                      IsChecked="{Binding EnableVideoSplash, UpdateSourceTrigger=PropertyChanged}"
                      FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
            <TextBlock FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="20,0,0,8"
                       TextWrapping="Wrap">
                <Run Text="Looks for "/>
                <Run Text="VideoTrailer.mp4" FontWeight="Bold" FontFamily="Consolas"/>
                <Run Text=" or "/>
                <Run Text="VideoMicrotrailer.mp4" FontWeight="Bold" FontFamily="Consolas"/>
                <Run Text=" in your Extra Metadata folder. Falls back to the static background image if no video is found. Logo overlay is still shown on top. Video loops if shorter than the splash duration."/>
            </TextBlock>

            <!-- Video source selector -->
            <StackPanel Margin="20,0,0,5">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EnableVideoSplash}" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Video source:" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding VideoSource, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Source={StaticResource VideoSourceValues}}"
                          Width="320" HorizontalAlignment="Left" Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource VideoSourceConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="'No fallback' options will use the static background image if the chosen file is missing."
                           FontStyle="Italic" Foreground="Gray" FontSize="11"/>
            </StackPanel>

            <!-- Mute audio -->
            <CheckBox Content="Mute video audio during splash"
                      IsChecked="{Binding VideoMuteAudio, UpdateSourceTrigger=PropertyChanged}"
                      Foreground="{DynamicResource TextBrush}"
                      Margin="20,0,0,5">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EnableVideoSplash}" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <!-- Disabled Games -->
            <TextBlock Text="Disabled Games" FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
            <TextBlock Text="Games with splash screen disabled via right-click menu. Click Enable to turn the splash screen back on."
                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <DataGrid ItemsSource="{Binding DisabledGamesView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Margin="0,0,0,5" MaxHeight="200">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Game" Binding="{Binding GameName}" Width="*"/>
                    <DataGridTemplateColumn Header="" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Enable" Click="EnableGame_Click" Tag="{Binding GameId}" Padding="4,2" FontSize="11"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Tip: Right-click any game in your library and go to Extensions → CineSplash → Toggle Splash Screen to disable it."
                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>